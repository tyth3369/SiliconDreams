# ===== SiliconDreams .gitignore =====

# 环境变量 (含 API Key)
.env
.env.local
.env.production

# GitHub Token
.github_token
*.token
*_token

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
venv/
.venv/

# 数据文件 (含 PDF 缓存和向量库)
data/pdfs/*
data/chroma_db/*
data/reports/*
data/*.db
data/*.db-shm
data/*.db-wal
!data/pdfs/.gitkeep
!data/chroma_db/.gitkeep
!data/reports/.gitkeep

# 模型缓存 (BGE-M3 等)
.cache/
models/
*.model

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Streamlit
.streamlit/secrets.toml

# 开发日志 (可选追踪)
# devlog/   # 如需追踪日志，取消此注释

# 临时文件
*.log
*.tmp
tmp/

# Test / quality caches
.coverage
.pytest_cache/
.ruff_cache/
htmlcov/
