# Copy to .env.production on the server. Never commit the real file.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_REASONER_MODEL=deepseek-v4-pro
TAVILY_API_KEY=tvly-your-tavily-api-key-here
APP_ENV=production
AUTH_ENABLED=true
APP_USERNAME=researcher
# Generate these two values with: python scripts/generate_auth_config.py
APP_PASSWORD_HASH='pbkdf2_sha256$600000$replace$salted_password_hash'
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=true
TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
REQUEST_LIMIT_PER_MINUTE=120
AI_LIMIT_PER_MINUTE=20
LOGIN_ATTEMPTS_PER_5_MINUTES=5
SESSION_TTL_SECONDS=43200
DEBUG=false
