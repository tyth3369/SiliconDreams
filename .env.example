# Copy this file to .env and replace the placeholders.
# Never commit .env or paste real keys into source files or documentation.

DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_REASONER_MODEL=deepseek-v4-pro

# Optional. Keep blank unless these rates match your provider contract.
# Values are USD per one million tokens; update them when provider pricing changes.
LLM_INPUT_CACHE_HIT_USD_PER_MILLION=
LLM_INPUT_CACHE_MISS_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=

TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Local development is unauthenticated by default. To test authentication,
# run `uv run python scripts/generate_auth_config.py` and paste its APP_* values here.
APP_ENV=development
AUTH_ENABLED=false
RATE_LIMIT_ENABLED=false
DEBUG=false
